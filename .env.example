# Copy this file to .env and fill in real values.

SECRET_KEY=change-this-to-something-random

# Local MongoDB by default. For MongoDB Atlas, use the connection string
# Atlas gives you, e.g. mongodb+srv://user:pass@cluster.mongodb.net/contracting_platform
MONGO_URI=mongodb://localhost:27017/

# From Google Cloud Console -> APIs & Services -> Credentials.
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true only when serving over HTTPS in production.
SESSION_COOKIE_SECURE=false
